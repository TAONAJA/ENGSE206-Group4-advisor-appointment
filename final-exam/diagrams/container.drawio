        <mxCell id="ext-2" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;fontColor=#333333;strokeColor=#666666;" value="&lt;b&gt;EXT-02: Notification Service&lt;/b&gt;&lt;br&gt;[External System Extension]&lt;br&gt;ส่งอีเมลแจ้งเตือนสถาบัน &amp;amp; Web Notification" vertex="1">
          <mxGeometry height="70" width="260" x="1240" y="530" as="geometry" />
