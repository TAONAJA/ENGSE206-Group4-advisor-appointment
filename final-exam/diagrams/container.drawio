        <mxCell id="ext-3" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;fontColor=#333333;strokeColor=#666666;" value="&lt;b&gt;EXT-03: File / Storage Service&lt;/b&gt;&lt;br&gt;[External System Core]&lt;br&gt;จัดเก็บไฟล์แนบประกอบคำขอ (.pdf, .docx) &amp;amp; คืนค่า URL" vertex="1">
