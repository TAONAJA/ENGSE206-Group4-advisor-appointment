                <mxCell id="sys-header" parent="1" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#1e3d59;fillColor=#1e3d59;fontColor=#ffffff;align=center;verticalAlign=middle;" value="&lt;div style=&quot;font-size: 15px;&quot;&gt;&lt;b style=&quot;color: rgb(255, 255, 255);&quot;&gt;Advisor Appointment System&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size: 11px; margin-top: 2px; color: rgb(208, 225, 253);&quot;&gt;ระบบนัดหมายเข้าพบอาจารย์ที่ปรึกษา&lt;/div&gt;" vertex="1">
